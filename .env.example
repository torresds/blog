# Local-only credentials for the isolated Docker Compose development database.
POSTGRES_USER=blog_local
POSTGRES_PASSWORD=blog_local_only
POSTGRES_DB=blog_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://blog_local:blog_local_only@127.0.0.1:5432/blog_dev
TEST_DATABASE_URL=postgres://blog_local:blog_local_only@127.0.0.1:5432/blog_test
