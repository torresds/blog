{
  "name": "@torresds/librarian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "migrate:dev": "node --env-file=../../.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir migrations --database-url-var DATABASE_URL --verbose=false",
    "migrate:test": "node --env-file=../../.env --import tsx scripts/migrate-test.ts",
    "testdb:reset": "node --env-file=../../.env --import tsx scripts/reset-test-database.ts",
    "test:integration": "node --env-file=../../.env --import tsx --test test/*.test.ts",
    "test:package-import": "npm run build && node --test test/package-import.test.mjs"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
