{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blog:bard:v1:manifest",
  "title": "Bard compile manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files", "toc", "diagnostics", "fingerprint"],
  "properties": {
    "schema_version": { "const": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "sha256"],
        "properties": {
          "path": {
            "anyOf": [
              { "enum": ["article.html", "article.css"] },
              { "type": "string", "pattern": "^assets/diagram-[0-9a-f]{64}\\.svg$" }
            ]
          },
          "media_type": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "toc": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "id", "title"],
        "properties": {
          "level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "id": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": { "enum": ["warning", "error"] },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
